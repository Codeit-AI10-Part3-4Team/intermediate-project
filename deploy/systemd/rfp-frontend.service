# RFP RAG Streamlit frontend.
# The only externally exposed service (GCP firewall: tcp:8501).
# 서버 설정(port 8501, address 0.0.0.0, 20MB upload)은 frontend/.streamlit/config.toml에서 옴
# (그래서 WorkingDirectory가 frontend/). 팀 예약 포트: FE 8501 / API 8090.
#
# 설치 (경로·계정이 다르면 아래 User/WorkingDirectory/ExecStart 수정):
#   sudo cp deploy/systemd/rfp-frontend.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now rfp-frontend
#
# ⚠️ 실행 venv는 streamlit 의존성을 자체 보유해야 함: <venv>/bin/pip install streamlit
#   과거에 PYTHONPATH로 공용 venv(/opt/jhub-venv)의 protobuf 등을 빌려 썼는데,
#   두 환경의 네이티브 라이브러리(numpy/protobuf/pyarrow)가 섞여 질의 시마다
#   SEGV로 프로세스가 죽고 세션이 초기화되는 사고가 있었음(2026-07-04).
#   PYTHONPATH로 타 venv site-packages를 주입하지 말 것.

[Unit]
Description=RFP RAG Frontend (Streamlit, 0.0.0.0:8501)
After=network.target rfp-api.service
Wants=rfp-api.service

[Service]
Type=simple
User=seen
WorkingDirectory=/home/seen/intermediate-project/frontend
Environment=RAG_API_BASE_URL=http://127.0.0.1:8090
ExecStart=/home/seen/ai/bin/streamlit run app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
